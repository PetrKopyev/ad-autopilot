# Только локальный демо-стенд. Скопируйте в .env.demo, заполните секреты по README.
COMPOSE_PROJECT_NAME=autopilot-demo
BACKEND_ENV_FILE=../.env.demo
APP_DOMAIN=localhost
APP_BASE_URL=https://localhost
POSTGRES_USER=autopilot_demo
POSTGRES_DB=autopilot_demo
POSTGRES_PASSWORD=replace-with-local-demo-password
# Замените пароль в DATABASE_URL вместе с POSTGRES_PASSWORD.
DATABASE_URL=postgresql+psycopg://autopilot_demo:replace-with-local-demo-password@db:5432/autopilot_demo
SECRET_KEY=replace-with-random-at-least-32-characters
TOKEN_ENCRYPTION_KEY=replace-with-generated-fernet-key
PLATFORM_MODE=fake
DEMO_LOGIN=1
DRY_RUN=false
TZ_DEFAULT=Europe/Moscow
