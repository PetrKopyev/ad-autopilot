{$APP_DOMAIN:localhost} {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }

    @api path /api /api/*
    handle @api {
        # Самое большое тело — фото до 10 МБ в multipart; остальное API ограничивает само (1 МБ на JSON).
        request_body {
            max_size 11MB
        }
        reverse_proxy api:8000
    }

    handle {
        root * /srv/web
        try_files {path} /index.html
        file_server
    }
}
