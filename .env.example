# Имя роли PostgreSQL; задайте при первом запуске.
POSTGRES_USER=autopilot
# Пароль PostgreSQL; замените заглушку случайной строкой перед запуском.
POSTGRES_PASSWORD=replace-with-random-password
# Имя базы PostgreSQL; задайте при первом запуске.
POSTGRES_DB=autopilot
# URL базы внутри Compose; собирается из POSTGRES_* выше (спецсимволы пароля кодируйте для URL).
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
# Публичный адрес приложения; локально Caddy использует HTTPS на localhost.
APP_BASE_URL=https://localhost
# Секрет приложения; замените заглушку результатом openssl rand -hex 32.
SECRET_KEY=replace-with-random-secret
# Ключ шифрования токенов; замените заглушку результатом cryptography.fernet.Fernet.generate_key().
TOKEN_ENCRYPTION_KEY=replace-with-fernet-key
# Режим площадок: live для API, fake для симулятора без внешних кабинетов.
PLATFORM_MODE=live
# Безопасный пробный режим; false включайте, когда разрешены изменения в кабинетах.
DRY_RUN=false
# ID приложения; получите при регистрации на oauth.yandex.ru.
YANDEX_CLIENT_ID=
# Секрет приложения; возьмите в настройках приложения на oauth.yandex.ru.
YANDEX_CLIENT_SECRET=
# База Direct API v5; официальный адрес, для песочницы смените хост на api-sandbox.direct.yandex.com.
DIRECT_API_URL=https://api.direct.yandex.com/json/v5
# База Direct API v501; официальный адрес, для песочницы смените хост на api-sandbox.direct.yandex.com.
DIRECT_API_V501_URL=https://api.direct.yandex.com/json/v501
# Признак песочницы Директа; включайте при работе с тестовым кабинетом.
DIRECT_SANDBOX=false
# Суммы лимитов в API Директа: false (по умолчанию) — без НДС, сервис делит лимит на (1 + VAT_PERCENT/100);
# true — суммы API уже с НДС и уходят как есть. См. LIMITATIONS.md.
# DIRECT_AMOUNTS_INCLUDE_VAT=false
# Ставка НДС для пересчёта сумм площадок, по умолчанию 22.
# VAT_PERCENT=22
# Суммы лимитов в API VK Рекламы: false (по умолчанию) — уходят как есть; true — ставка НДС сверх лимита VK,
# сервис делит лимит на (1 + VAT_PERCENT/100), чтобы трата с НДС не превысила бюджет.
# VK_AMOUNTS_INCLUDE_VAT=false
# ID приложения VK Рекламы; получите после регистрации приложения и доступа к API.
VK_CLIENT_ID=
# Секрет приложения VK Рекламы; возьмите в настройках приложения.
VK_CLIENT_SECRET=
# Кнопка «Войти через VK»; включайте, только когда VK разрешил приложению режим authorization_code.
# VK_OAUTH_ENABLED=false
# ID каталога Yandex Cloud; скопируйте со страницы каталога в консоли.
YC_FOLDER_ID=
# API-ключ сервисного аккаунта Yandex Cloud; создайте в консоли с доступом к моделям.
YC_API_KEY=
# Модель YandexGPT; имя из каталога моделей Yandex Cloud.
YANDEXGPT_MODEL=yandexgpt/latest
# Модель картинок Alice AI ART; имя из каталога моделей Yandex AI Studio.
YANDEXART_MODEL=aliceai-image-art-3.0/latest
# Резерв рекламного бюджета в процентах; значение по плану проекта.
BUDGET_RESERVE_PCT=8
# Лимит расходов ИИ на онбординг в рублях; значение по плану проекта.
AI_SPEND_ONBOARDING_LIMIT_RUB=60
# Недельный лимит расходов ИИ в рублях; значение по плану проекта.
AI_SPEND_WEEKLY_LIMIT_RUB=25
# Часовой пояс по умолчанию; используйте имя из базы IANA.
TZ_DEFAULT=Europe/Moscow
# Домен для Caddy; локально localhost, на сервере домен с DNS-записью на VPS.
APP_DOMAIN=localhost

# Каталог картинок: локально media; в Docker api и worker используют общий том /data/media.
MEDIA_DIR=media
# Демо-вход разрешён только при PLATFORM_MODE=fake и DEMO_LOGIN=1 одновременно.
DEMO_LOGIN=0
# ID пакета VK Рекламы; раскомментируйте и укажите положительное число для live-режима.
# VK_PACKAGE_ID=123
# Цель оптимизации campaign VK (Top@Mail/приложения): source_id и имя. Без source_id в campaign не уходит.
# VK_PRICED_GOAL_SOURCE_ID=
# VK_PRICED_GOAL_NAME=Заявка
